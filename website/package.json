{
  "name": "@supcomputer/website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "sup computer studio website — custom Next.js, renders synced research-docs",
  "scripts": {
    "sync-content": "node scripts/sync-content.mjs && node scripts/build-text.mjs && node scripts/build-sitemap.mjs",
    "predev": "npm run sync-content",
    "dev": "next dev --webpack",
    "prebuild": "npm run sync-content",
    "build": "next build --webpack",
    "start": "next start",
    "test": "node --test lib/*.test.mjs"
  },
  "dependencies": {
    "@supcomputer/player": "file:../player",
    "chess.js": "^1.4.0",
    "gray-matter": "4.0.3",
    "next": "16.4.2",
    "onnxruntime-node": "1.30.0",
    "opentype.js": "^1.3.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "9.0.1",
    "rehype-raw": "7.0.0",
    "remark-gfm": "4.0.0",
    "supcpu": "file:../cli"
  },
  "devDependencies": {
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-preset-env": "^11.3.2"
  }
}
