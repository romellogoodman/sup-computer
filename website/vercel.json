{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "export ONNXRUNTIME_NODE_INSTALL=skip && npm ci && npm ci --prefix ../player && npm ci --prefix ../cli --include=dev && sh scripts/prune-ort.sh",
  "functions": {
    "api/*.js": {
      "maxDuration": 300,
      "includeFiles": "node_modules/onnxruntime-node/bin/napi-v6/linux/x64/*",
      "excludeFiles": "{website/node_modules/onnxruntime-node/bin/napi-v6/darwin/**,website/node_modules/onnxruntime-node/bin/napi-v6/win32/**,cli/node_modules/onnxruntime-node/**,player/node_modules/onnxruntime-web/**}"
    }
  },
  "redirects": [
    {
      "source": "/model-player",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/model-player/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/interfaces",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/interfaces/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:path((?!api/|_next/|\\.well-known)(?:[^/]+/)*[^/.]+)",
      "destination": "/:path/",
      "permanent": true
    },
    {
      "source": "/:file((?:[^/]+/)*[^/]+\\.\\w+)/",
      "destination": "/:file",
      "permanent": true
    }
  ]
}
