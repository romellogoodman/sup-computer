% Lowercase-only driver for the sweep. Same Computer Modern program Knuth
% ships -- roman.mf minus the majuscules, numerals, punctuation, accents and
% ligature tables, which the corpus never sees and which cost 4x the compile.
font_coding_scheme:="TeX text";

mode_setup; font_setup;

input romanl;  % lower case (minuscules)

font_slant slant; font_x_height x_height#;
if monospace: font_normal_space 9u#;
 font_quad 18u#;
 font_extra_space 9u#;
else: font_normal_space 6u#+2letter_fit#;
 font_normal_stretch 3u#; font_normal_shrink 2u#;
 font_quad 18u#+4letter_fit#;
 font_extra_space 2u#; fi

bye.
